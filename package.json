{
  "name": "fifa-iq",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint:staged": "lint-staged"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "frontend/src/**/*.{js,jsx}": [
      "npm --prefix frontend exec eslint -- --config frontend/eslint.config.js --fix"
    ],
    "backend/**/*.py": [
      "python -m compileall"
    ]
  }
}